+package org.egov.excelingestion.service;
+
+import org.egov.common.contract.request.RequestInfo;
+import org.egov.common.producer.Producer;
+import org.egov.excelingestion.config.ExcelIngestionConfig;
+import org.egov.excelingestion.config.KafkaTopicConfig;
+import org.egov.excelingestion.config.ProcessingConstants;
+import org.egov.excelingestion.exception.CustomExceptionHandler;
+import org.egov.excelingestion.web.models.ProcessResource;
+import org.egov.excelingestion.web.models.SheetDataTemp;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.context.ApplicationContext;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+/**
+ * The WorldPop population column is reference-only: it must never reach eg_ex_in_sheet_data_temp.
+ */
+class ReferenceOnlyColumnPersistenceTest {
+
+    @Test
+    @SuppressWarnings("unchecked")
+    void worldPopColumnIsRemovedBeforeRowsArePublished() {
+        Producer producer = mock(Producer.class);
+        KafkaTopicConfig topics = mock(KafkaTopicConfig.class);
+        when(topics.getSheetDataSaveTopic()).thenReturn("save-sheet-data-temp");
+        ConfigBasedProcessingService service = new ConfigBasedProcessingService(
+                mock(MDMSConfigService.class), mock(CustomExceptionHandler.class), mock(MDMSService.class),
+                mock(ApplicationContext.class), producer, topics, mock(ExcelIngestionConfig.class),
+                mock(OutsideHouseholdTypeMasterService.class));
+
+        Map<String, Object> row = new HashMap<>();
+        row.put("__actualRowNumber__", 3);
+        row.put(ProcessingConstants.BOUNDARY_CODE_COLUMN_KEY, "MZ_NAMPULA_MOMA_01");
+        row.put(ProcessingConstants.WORLDPOP_POPULATION_COLUMN, 4821);
+        row.put("TARGET_POPULATION", 4000);
+        ProcessResource resource = ProcessResource.builder().tenantId("mz").referenceId("campaign-1")
+                .fileStoreId("file-1").build();
+
+        ReflectionTestUtils.invokeMethod(service, "saveSheetDataToTemp", "HCM_ADMIN_CONSOLE_BOUNDARY_DATA",
+                List.of(row), resource, Map.of(), new RequestInfo());
+
+        ArgumentCaptor<Map<String, Object>> message = ArgumentCaptor.forClass(Map.class);
+        verify(producer).push(eq("mz"), any(), message.capture());
+        List<SheetDataTemp> saved = (List<SheetDataTemp>) message.getValue().get("sheetData");
+        Map<String, Object> rowJson = saved.get(0).getRowJson();
+        assertFalse(rowJson.containsKey(ProcessingConstants.WORLDPOP_POPULATION_COLUMN));
+        assertFalse(rowJson.containsKey("__actualRowNumber__"));
+        assertEquals(4000, rowJson.get("TARGET_POPULATION"));
+        assertEquals(3, saved.get(0).getRowNumber());
+        assertTrue(row.containsKey(ProcessingConstants.WORLDPOP_POPULATION_COLUMN), "parsed data is not mutated");
+    }
+}
