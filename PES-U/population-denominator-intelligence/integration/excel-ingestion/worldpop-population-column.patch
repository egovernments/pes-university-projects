+package org.egov.excelingestion.service;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import lombok.extern.slf4j.Slf4j;
+import org.egov.common.contract.request.RequestInfo;
+import org.egov.excelingestion.config.ExcelIngestionConfig;
+import org.springframework.boot.web.client.RestTemplateBuilder;
+import org.springframework.stereotype.Service;
+import org.springframework.web.client.RestTemplate;
+
+import java.time.Duration;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+
+/**
+ * WorldPop population per boundary code from the PDI service, used only to fill the
+ * reference column of the generated boundary sheet.
+ *
+ * <p>Fail-open: when the feature is off, PDI has no active run for the hierarchy, or PDI is
+ * down or slow, the result is empty and the sheet is generated without the column.
+ */
+@Service
+@Slf4j
+public class PopulationService {
+
+    private static final String TOTAL_GROUP = "total";
+
+    private static final int MAX_ATTEMPTS = 2;
+
+    private final ExcelIngestionConfig config;
+
+    private final RestTemplate restTemplate;
+
+    public PopulationService(ExcelIngestionConfig config, RestTemplateBuilder restTemplateBuilder) {
+        this.config = config;
+        Duration timeout = Duration.ofMillis(config.getPdiSearchTimeoutMs());
+        this.restTemplate = restTemplateBuilder
+                .setConnectTimeout(timeout)
+                .setReadTimeout(timeout)
+                .build();
+    }
+
+    /**
+     * Total population by boundary code from PDI's active run. Codes PDI has no figure for map
+     * to null. Empty when the column should be left out of the sheet.
+     */
+    public Optional<Map<String, Integer>> fetchTotalPopulation(String tenantId, String hierarchyType,
+                                                               List<String> boundaryCodes, RequestInfo requestInfo) {
+        if (!config.isWorldpopColumnEnabled() || boundaryCodes == null || boundaryCodes.isEmpty()) {
+            return Optional.empty();
+        }
+        try {
+            for (int attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
+                FetchResult result = fetchFromOneRun(tenantId, hierarchyType, boundaryCodes, requestInfo);
+                if (!result.runChanged()) {
+                    result.population().ifPresent(population -> log.info(
+                            "WorldPop population for {}/{}: {} codes requested, {} returned",
+                            tenantId, hierarchyType, boundaryCodes.size(), population.size()));
+                    return result.population();
+                }
+                log.info("PDI switched its active run during the lookup for {}/{}; retrying", tenantId, hierarchyType);
+            }
+            log.warn("PDI active run kept changing for {}/{}; boundary sheet generated without WorldPop population",
+                    tenantId, hierarchyType);
+            return Optional.empty();
+        } catch (Exception e) {
+            log.warn("WorldPop population unavailable for {}/{}, boundary sheet generated without it: {}",
+                    tenantId, hierarchyType, e.getMessage());
+            return Optional.empty();
+        }
+    }
+
+    /** Fetches every chunk; reports {@code runChanged} when chunks were answered by different runs. */
+    private FetchResult fetchFromOneRun(String tenantId, String hierarchyType, List<String> boundaryCodes,
+                                        RequestInfo requestInfo) {
+        Map<String, Integer> population = new HashMap<>();
+        String runId = null;
+        int chunkSize = Math.max(1, config.getPdiSearchChunkSize());
+        for (int from = 0; from < boundaryCodes.size(); from += chunkSize) {
+            List<String> chunk = boundaryCodes.subList(from, Math.min(from + chunkSize, boundaryCodes.size()));
+            JsonNode response = search(tenantId, hierarchyType, chunk, requestInfo);
+            JsonNode run = response == null ? null : response.path("PopulationRun");
+            if (run == null || run.isNull() || run.isMissingNode()) {
+                log.info("No WorldPop population run for {}/{}; boundary sheet generated without it",
+                        tenantId, hierarchyType);
+                return new FetchResult(Optional.empty(), false);
+            }
+            String chunkRunId = run.path("id").asText();
+            if (runId != null && !runId.equals(chunkRunId)) {
+                return new FetchResult(Optional.empty(), true);
+            }
+            runId = chunkRunId;
+            for (JsonNode row : response.path("BoundaryPopulation")) {
+                JsonNode total = row.path("population").path(TOTAL_GROUP);
+                population.put(row.path("boundaryCode").asText(), total.isNumber() ? total.asInt() : null);
+            }
+        }
+        return new FetchResult(Optional.of(population), false);
+    }
+
+    private record FetchResult(Optional<Map<String, Integer>> population, boolean runChanged) {
+    }
+
+    private JsonNode search(String tenantId, String hierarchyType, List<String> boundaryCodes,
+                            RequestInfo requestInfo) {
+        Map<String, Object> criteria = new HashMap<>();
+        criteria.put("tenantId", tenantId);
+        criteria.put("hierarchyType", hierarchyType);
+        criteria.put("boundaryCodes", boundaryCodes);
+        criteria.put("groups", List.of(TOTAL_GROUP));
+        Map<String, Object> body = new HashMap<>();
+        body.put("RequestInfo", requestInfo);
+        body.put("BoundaryPopulationSearchCriteria", criteria);
+        return restTemplate.postForObject(config.getPdiBoundaryPopulationSearchUrl(), body, JsonNode.class);
+    }
+}
