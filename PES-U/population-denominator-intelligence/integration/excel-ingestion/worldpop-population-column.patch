+                .andRespond(withSuccess(response("run-1", row("A", "4821", "POINT_VORONOI") + ","
+                        + row("B", "null", "NO_GEOMETRY")), MediaType.APPLICATION_JSON));
+
+        Optional<Map<String, Integer>> result =
+                service.fetchTotalPopulation("mz", "ADMIN", List.of("A", "B", "C"), new RequestInfo());
+
+        server.verify();
+        assertTrue(result.isPresent());
+        assertEquals(4821, result.get().get("A"));
+        assertTrue(result.get().containsKey("B"));
+        assertNull(result.get().get("B"));
+        assertTrue(!result.get().containsKey("C"), "codes PDI does not know stay absent");
+    }
+
+    @Test
+    void noActiveRunMeansNoColumn() {
+        PopulationService service = service();
+        MockRestServiceServer server = customizer.getServer();
+        server.expect(requestTo(URL)).andRespond(withSuccess(response(null, ""), MediaType.APPLICATION_JSON));
+
+        assertTrue(service.fetchTotalPopulation("mz", "ADMIN", List.of("A"), new RequestInfo()).isEmpty());
+        server.verify();
+    }
+
+    @Test
+    void pdiFailureIsSwallowed() {
+        PopulationService service = service();
+        MockRestServiceServer server = customizer.getServer();
+        server.expect(requestTo(URL)).andRespond(withServerError());
+
+        assertTrue(service.fetchTotalPopulation("mz", "ADMIN", List.of("A"), new RequestInfo()).isEmpty());
+        server.verify();
+    }
+
+    @Test
+    void disabledFeatureMakesNoCall() {
+        config.setWorldpopColumnEnabled(false);
+        PopulationService service = service();
+        MockRestServiceServer server = customizer.getServer();
+        server.expect(never(), requestTo(URL));
+
+        assertTrue(service.fetchTotalPopulation("mz", "ADMIN", List.of("A"), new RequestInfo()).isEmpty());
+        server.verify();
+    }
+
+    @Test
+    void largeCodeListsAreSplitIntoChunks() {
+        config.setPdiSearchChunkSize(2);
+        PopulationService service = service();
+        MockRestServiceServer server = customizer.getServer();
+        server.expect(requestTo(URL)).andExpect(jsonPath("$.BoundaryPopulationSearchCriteria.boundaryCodes.length()").value(2))
+                .andRespond(withSuccess(response("run-1", row("A", "1", "ZONAL_UPLOAD") + "," + row("B", "2", "ZONAL_UPLOAD")),
+                        MediaType.APPLICATION_JSON));
+        server.expect(requestTo(URL)).andExpect(jsonPath("$.BoundaryPopulationSearchCriteria.boundaryCodes.length()").value(1))
+                .andRespond(withSuccess(response("run-1", row("C", "3", "ZONAL_UPLOAD")), MediaType.APPLICATION_JSON));
+
+        Optional<Map<String, Integer>> result =
+                service.fetchTotalPopulation("mz", "ADMIN", List.of("A", "B", "C"), new RequestInfo());
+
+        server.verify();
+        assertEquals(Map.of("A", 1, "B", 2, "C", 3), result.orElseThrow());
+    }
+
+    @Test
+    void runSwitchBetweenChunksIsRetriedSoTheSheetNeverMixesRuns() {
+        config.setPdiSearchChunkSize(1);
+        PopulationService service = service();
+        MockRestServiceServer server = customizer.getServer();
+        server.expect(requestTo(URL)).andRespond(withSuccess(response("run-1", row("A", "1", "ZONAL_UPLOAD")),
+                MediaType.APPLICATION_JSON));
+        server.expect(requestTo(URL)).andRespond(withSuccess(response("run-2", row("B", "20", "ZONAL_UPLOAD")),
+                MediaType.APPLICATION_JSON));
+        server.expect(requestTo(URL)).andRespond(withSuccess(response("run-2", row("A", "10", "ZONAL_UPLOAD")),
+                MediaType.APPLICATION_JSON));
+        server.expect(requestTo(URL)).andRespond(withSuccess(response("run-2", row("B", "20", "ZONAL_UPLOAD")),
+                MediaType.APPLICATION_JSON));
+
+        Optional<Map<String, Integer>> result =
+                service.fetchTotalPopulation("mz", "ADMIN", List.of("A", "B"), new RequestInfo());
+
+        server.verify();
+        assertEquals(Map.of("A", 10, "B", 20), result.orElseThrow());
+    }
+}
